{
  "$schema": "../../schemas/npc-event-script.schema.json",
  "schema_version": 4,
  "id": "cobbleventure:npc/hall_guide",
  "enabled": true,
  "name": {
    "ko_kr": "전당 안내원",
    "en_us": "Hall Guide"
  },
  "description": {
    "ko_kr": "명예의 전당에서 다음 세대 이동을 안내합니다."
  },
  "tags": [
    "service",
    "hall_of_fame",
    "building_runtime"
  ],
  "placement_profile": {
    "classification": "ambient",
    "preferred_biomes": [],
    "automatic_town_placement": false,
    "automatic_route_placement": false
  },
  "npc": {
    "display_name": {
      "ko_kr": "전당 안내원",
      "en_us": "Hall Guide"
    },
    "role": "default",
    "trainer_class": "cobbleventure:trainer_class/pokemart_clerk",
    "appearance": {
      "source": "custom",
